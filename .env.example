# Supabase project (Settings → API). The anon key is public by design; security comes from RLS.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=

# Browser-only demo CMS for previews (ignored when Supabase is configured). Never enable in production.
# VITE_CMS_DEMO=true

# Optional: host under a sub-path, e.g. /atelier/
# VITE_BASE=/
