{
  "name": "atelier-studio",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/postbuild.mjs",
    "lint": "oxlint",
    "preview": "vite preview",
    "images": "node scripts/optimize-images.mjs",
    "build:preview": "VITE_BASE=./ VITE_ROUTER=memory VITE_CMS_DEMO=true vite build --outDir dist-preview && node scripts/make-preview-page.mjs",
    "seed:generate": "node --experimental-strip-types --no-warnings scripts/generate-seed.mjs",
    "build:static": "npm run build && node scripts/prerender.mjs && node scripts/precompress.mjs",
    "serve": "node scripts/serve-dist.mjs",
    "test:unit": "node --experimental-strip-types --no-warnings --test 'tests/unit/*.test.ts'",
    "test:e2e": "playwright test --trace off",
    "test:db": "bash scripts/test-db.sh",
    "test": "npm run test:unit && npm run test:e2e",
    "test:supabase-mode": "bash scripts/test-supabase-mode.sh"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource-variable/noto-serif-display": "^5.3.0",
    "@gsap/react": "^2.1.2",
    "@supabase/supabase-js": "^2.119.2",
    "gsap": "^3.15.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.90.0",
    "playwright": "^1.63.0",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.5",
    "typescript": "~7.0.2",
    "vite": "^8.3.6"
  }
}
